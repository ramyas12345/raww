{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/cra"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/upload", "destination": "api/index.py" },
    { "source": "/regression", "destination": "api/index.py" },
    { "source": "/correlation", "destination": "api/index.py" },
    { "source": "/(.*)", "destination": "frontend/index.html" }
  ]
}